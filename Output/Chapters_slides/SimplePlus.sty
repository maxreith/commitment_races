%──────────────────────────────────────────────────────────────
%  4.  Title page & section header frames (plain + no number)
%──────────────────────────────────────────────────────────────
% Title page
\makeatletter
\renewcommand{\beamer@maketitle}{%
  \ifbeamer@inframe\else
    \frame[plain,noframenumbering]{\titlepage}\fi}
\makeatother

% Section header slide
\AtBeginSection{%
  \begin{frame}[plain,noframenumbering]
    \centering\vfill
    \usebeamerfont{frametitle}\usebeamercolor[fg]{titlelike}
    {\hypersetup{hidelinks}\insertsection}\par
    \vskip-0.5em\hrulefill\vfill
  \end{frame}}

%──────────────────────────────────────────────────────────────
%  5.  Final glue
%──────────────────────────────────────────────────────────────
\mode<presentation>
\mode<all>
\endinput
