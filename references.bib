	keywords = {C72, C78, Divide-the-Dollar Game, Energy Supply and Demand, Game Theory, General Economical Equilibrium, Market Structure and Economic Design, Microeconomics, Mixed-strategy equilibria, Nash Demand Game, Public Choice and Political Economy},
}

