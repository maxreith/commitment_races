@misc{katzke_manhattan_2024,
	location = {Rochester, {NY}},
	title = {The Manhattan Trap: Why a Race to Artificial Superintelligence is Self-Defeating},
	url = {https://papers.ssrn.com/abstract=5067833},
	doi = {10.2139/ssrn.5067833},
	shorttitle = {The Manhattan Trap},
	abstract = {This paper examines the strategic dynamics of international competition to develop Artificial Superintelligence ({ASI}). We argue that the same assumptions that might motivate the {US} to race to develop {ASI} also imply that such a race is extremely dangerous. These assumptions—that {ASI} would provide a decisive military advantage and that states are rational actors prioritizing survival—imply that a race would heighten three critical risks: great power conflict, loss of control of {ASI} systems, and the undermining of liberal democracy. Our analysis shows that {ASI} presents a trust dilemma rather than a prisoner's dilemma, suggesting that international cooperation to control {ASI} development is both preferable and strategically sound. We conclude that cooperation is achievable.},
	number = {5067833},
	publisher = {Social Science Research Network},
	author = {Katzke, Corin and Futerman, Gideon},
	urldate = {2025-01-25},
	date = {2024-12-21},
	langid = {english},
	keywords = {Corin Katzke, Gideon Futerman, {SSRN}, The Manhattan Trap: Why a Race to Artificial Superintelligence is Self-Defeating},
}

