@article{lanzani_dynamic_nodate,
	title = {Dynamic Concern for Misspeciﬁcation},
	abstract = {We consider an agent who posits a set of probabilistic models for the payoﬀ-relevant outcomes. The agent has a prior over this set but fears the actual model is omitted and hedges against this possibility. The concern for misspeciﬁcation is endogenous: If a model explains the previous observations well, the concern attenuates. We show that diﬀerent static preferences under uncertainty (subjective expected utility, maxmin, robust control) arise in the long run, depending on how quickly the agent becomes unsatisﬁed with unexplained evidence and whether they are misspeciﬁed. The misspeciﬁcation concern’s endogeneity naturally induces behavior cycles, and we characterize the limit action frequency. This model is consistent with the evidence on monetary policy cycles and choices in the face of complex tax schedules. Finally, we axiomatize in terms of observable choices this decision criterion and how quickly the agent adjusts their misspeciﬁcation concern.},
	author = {Lanzani, Giacomo},
	langid = {english},
}

@article{cerreia-vioglio_caution_2024,
	title = {Caution and Reference Effects},
	volume = {92},
	rights = {© 2024 The Authors. Econometrica published by John Wiley \& Sons Ltd on behalf of The Econometric Society},
	issn = {1468-0262},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.3982/ECTA21748},
	doi = {10.3982/ECTA21748},
	abstract = {We introduce Cautious Utility, a new model based on the idea that individuals are unsure of trade-offs between goods and apply caution. The model yields an endowment effect, even when gains and losses are treated symmetrically. Moreover, it implies either loss aversion or loss neutrality for risk, but in a way unrelated to the endowment effect, and it captures the certainty effect, providing a novel unified explanation of all three phenomena. Cautious Utility can help organize empirical evidence, including some that directly contradicts leading alternatives.},
	pages = {2069--2103},
	number = {6},
	journaltitle = {Econometrica},
	author = {Cerreia-Vioglio, Simone and Dillenberger, David and Ortoleva, Pietro},
	urldate = {2025-05-20},
	date = {2024},
	langid = {english},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.3982/{ECTA}21748},
	keywords = {Cautious Utility, Non-Expected Utility, certainty effect, cumulative prospect theory, endowment effect, loss aversion},
}

@article{metzler_fiscal_nodate,
	title = {Fiscal Pol(l)icy - Voting and Optimal Unemployment Insurance},
	abstract = {I investigate what level of unemployment benefits is supported by median voters and whether this level is consistent with the one maximizing social welfare. To answer this question, I construct a search and matching model of the labor market with household heterogeneity and incomplete markets. Calibrated to the {US} economy, the optimal level of unemployment insurance is less than 1\% of the pre-unemployment wage. If labor markets react strongly to increases in benefits through higher unemployment, this level of unemployment benefits coincides with the one chosen by the median voter. In a less responsive labor market, the median voter supports a replacement rate of 21\% of the previous after-tax wage, which is roughly midway between the optimal rate and the current {US} level. Allowing for the possibility that households do not anticipate increased unemployment due to higher unemployment benefits, a majority supports full insurance of unemployment risk, even if only a small minority of households is unemployed at a time.},
	author = {Metzler, Paul},
	langid = {english},
}

